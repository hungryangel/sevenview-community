{
  "name": "sevenview-community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first seven-view clinical photo standardization and contact-sheet export.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/hungryangel/sevenview-community.git"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prepare-static-site.mjs",
    "preview": "vite preview",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "react-doctor": "react-doctor",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:bundle",
    "verify:community": "node scripts/verify-community-release.mjs",
    "verify:bundle": "node scripts/verify-community-release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "react-doctor": "0.9.12",
    "react-grab": "0.2.0",
    "react-scan": "0.5.7",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
